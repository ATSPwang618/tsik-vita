# Shell entry points must execute from Windows/WSL checkouts too.
*.sh text eol=lf
*.py text eol=lf
# Shader identity hashes exact authored bytes; do not rewrite at checkout.
knife/vita/shaders/*.cg -text
knife/vita/shaders/generated/** -text
knife/knife/data/vita_* -text
# Preserve the verified upstream archives, headers, modules and notices exactly.
knife/vita/vendor/** -text -whitespace
